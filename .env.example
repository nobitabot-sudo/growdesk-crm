# Copy this file to .env and fill in real values for local runs.
# On a hosting platform (Render, Railway, etc.), set these in that
# platform's dashboard instead — never commit real keys to the repo.

# Required for persistent storage (Supabase/Neon/any Postgres). Without this
# set, the app falls back to a local data/db.json file — fine for testing on
# your own machine, but that file gets wiped on most free hosts' restarts.
# See README.md "Database setup (Supabase)" for how to get this connection string.
DATABASE_URL=

# Required for the Scrape tab (Google Places).
# Get one at console.cloud.google.com — enable "Places API", attach billing
# (Google's own $200/month free credit covers small-scale use).
GOOGLE_PLACES_API_KEY=

# Required for the 🤖 Bot tab (Groq — genuinely free, no card).
# Get one at console.groq.com -> API Keys.
GROQ_API_KEY=

# Optional — overrides the default model for each of the above.
# GEMINI_MODEL / GROQ_MODEL etc. are not needed unless you want to change
# the default; see README.md for the current defaults and alternatives.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional — defaults to 3000.
PORT=3000
